<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.ContextMenuEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:WinCustoms.Common"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,12" Spacing="2">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="우클릭 프로그램 등록" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                       Text="자주 쓰는 프로그램을 마우스 오른쪽 버튼 메뉴에 추가합니다. HKCU 범위에만 기록하므로 관리자 권한이 필요 없습니다." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- ── 새 항목 추가 ─────────────────────────────── -->
                <Border Style="{StaticResource TweakCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="새 항목 추가" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Header="프로그램 경로"
                                     PlaceholderText="C:\Program Files\...\app.exe"
                                     Text="{x:Bind ViewModel.NewExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseCommand}" />
                        </Grid>

                        <TextBox Header="메뉴에 표시할 이름"
                                 PlaceholderText="예: Notepad++로 열기"
                                 Text="{x:Bind ViewModel.NewDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="파일에 표시" IsChecked="{x:Bind ViewModel.ShowForFiles, Mode=TwoWay}" />
                            <CheckBox Content="폴더에 표시" IsChecked="{x:Bind ViewModel.ShowForFolders, Mode=TwoWay}" />
                            <CheckBox Content="선택한 경로를 인수로 전달"
                                      IsChecked="{x:Bind ViewModel.PassTargetPath, Mode=TwoWay}"
                                      ToolTipService.ToolTip="끄면 프로그램만 실행하고 파일 경로를 넘기지 않습니다." />
                        </StackPanel>

                        <Button Content="우클릭 메뉴에 추가"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.AddCommand}" />
                    </StackPanel>
                </Border>

                <!-- ── 등록된 항목 ──────────────────────────────── -->
                <TextBlock Text="등록된 항목" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />

                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                           Margin="4,0,0,0"
                           Text="아직 등록한 항목이 없습니다. 위에서 프로그램을 추가해 보세요."
                           Visibility="{x:Bind views:XamlHelpers.Hide(ViewModel.HasEntries), Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="common:CustomContextMenuEntry">
                            <Border Style="{StaticResource TweakCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ExecutablePath}"
                                                   Style="{StaticResource DescriptionTextStyle}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="삭제"
                                            VerticalAlignment="Center"
                                            Click="OnRemoveClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Visibility="{x:Bind views:XamlHelpers.ShowIfText(ViewModel.StatusMessage), Mode=OneWay}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center" />

                    <Button Content="탐색기 다시 시작"
                            Command="{x:Bind ViewModel.RestartExplorerCommand}"
                            ToolTipService.ToolTip="변경 사항이 바로 보이지 않으면 눌러 주세요." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
