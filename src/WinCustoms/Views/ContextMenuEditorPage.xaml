<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.ContextMenuEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:WinCustoms.Common"
    xmlns:services="using:WinCustoms.Services"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,4" Spacing="2">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="우클릭 프로그램 등록 및 제거" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

            <SelectorBar SelectionChanged="OnTabSelectionChanged" Margin="-12,8,0,0">
                <SelectorBarItem Text="제거" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>

                <SelectorBarItem Text="등록">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </StackPanel>

        <!-- ══ 제거 탭 ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsRemoveTabSelected), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,8,24,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         MaxWidth="320"
                         HorizontalAlignment="Left"
                         PlaceholderText="이름 또는 경로로 검색"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DescriptionTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0"
                               Text="{x:Bind ViewModel.InventorySummary, Mode=OneWay}" />

                    <CheckBox Content="Windows 기본 항목도 표시"
                              MinWidth="0"
                              IsChecked="{x:Bind ViewModel.ShowSystemEntries, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <ProgressRing Grid.Row="1"
                          Width="32" Height="32"
                          Margin="0,40,0,0"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                          Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsScanning), Mode=OneWay}" />

            <InfoBar Grid.Row="1"
                     Margin="24,0,24,0"
                     VerticalAlignment="Top"
                     IsClosable="False"
                     Severity="Informational"
                     Title="표시할 항목이 없습니다"
                     Message="{x:Bind ViewModel.EmptyInventoryMessage, Mode=OneWay}"
                     IsOpen="{x:Bind views:XamlHelpers.Neither(ViewModel.IsScanning, ViewModel.HasInstalledEntries), Mode=OneWay}" />

            <ScrollViewer Grid.Row="1"
                          Padding="24,0,24,16"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.HasInstalledEntries), Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledEntries, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ShellMenuEntry">
                            <Border Style="{StaticResource TweakCardStyle}" Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Visibility="{x:Bind views:XamlHelpers.Show(IsOwn)}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="WinCustoms 등록" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Visibility="{x:Bind views:XamlHelpers.Show(IsSystem)}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="Windows 기본" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Visibility="{x:Bind views:XamlHelpers.Show(NeedsElevation)}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="관리자 권한" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeBorderStyle}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind ScopeText}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind Detail}"
                                                   Style="{StaticResource DescriptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <ProgressRing Width="18" Height="18"
                                                      VerticalAlignment="Center"
                                                      IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                      Visibility="{x:Bind views:XamlHelpers.Show(IsBusy), Mode=OneWay}" />

                                        <ToggleSwitch MinWidth="0"
                                                      OnContent="표시"
                                                      OffContent="숨김"
                                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                      Toggled="OnEntryToggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ 등록 탭 ═══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      Padding="24,8,24,16"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsRegisterTabSelected), Mode=OneWay}">
            <StackPanel Spacing="12">

                <!-- ── 새 항목 추가 ─────────────────────────────── -->
                <Border Style="{StaticResource TweakCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="새 항목 추가" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Header="프로그램 경로"
                                     PlaceholderText="C:\Program Files\...\app.exe"
                                     Text="{x:Bind ViewModel.NewExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseCommand}" />
                        </Grid>

                        <TextBox Header="메뉴에 표시할 이름"
                                 PlaceholderText="예: Notepad++로 열기"
                                 Text="{x:Bind ViewModel.NewDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="파일에 표시" IsChecked="{x:Bind ViewModel.ShowForFiles, Mode=TwoWay}" />
                            <CheckBox Content="폴더에 표시" IsChecked="{x:Bind ViewModel.ShowForFolders, Mode=TwoWay}" />
                            <CheckBox Content="선택한 경로를 인수로 전달"
                                      IsChecked="{x:Bind ViewModel.PassTargetPath, Mode=TwoWay}"
                                      ToolTipService.ToolTip="끄면 프로그램만 실행하고 파일 경로를 넘기지 않습니다." />
                        </StackPanel>

                        <Button Content="우클릭 메뉴에 추가"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.AddCommand}" />
                    </StackPanel>
                </Border>

                <!-- ── 등록된 항목 ──────────────────────────────── -->
                <TextBlock Text="등록된 항목" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />

                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                           Margin="4,0,0,0"
                           Text="아직 등록한 항목이 없습니다. 위에서 프로그램을 추가해 보세요."
                           Visibility="{x:Bind views:XamlHelpers.Hide(ViewModel.HasEntries), Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="common:CustomContextMenuEntry">
                            <Border Style="{StaticResource TweakCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ExecutablePath}"
                                                   Style="{StaticResource DescriptionTextStyle}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="삭제"
                                            VerticalAlignment="Center"
                                            Click="OnRemoveClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Visibility="{x:Bind views:XamlHelpers.ShowIfText(ViewModel.StatusMessage), Mode=OneWay}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center" />

                    <Button Content="목록 새로 고침"
                            Command="{x:Bind ViewModel.ScanCommand}"
                            Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsRemoveTabSelected), Mode=OneWay}" />

                    <Button Content="탐색기 다시 시작"
                            Command="{x:Bind ViewModel.RestartExplorerCommand}"
                            ToolTipService.ToolTip="변경 사항이 바로 보이지 않으면 눌러 주세요. 셸 확장 항목은 반드시 한 번 눌러야 반영됩니다." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
