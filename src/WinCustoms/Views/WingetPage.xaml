<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.WingetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:WinCustoms.Services"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,4" Spacing="2">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

            <SelectorBar SelectionChanged="OnTabSelectionChanged" Margin="-12,8,0,0">
                <SelectorBarItem Text="추천" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="검색">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </StackPanel>

        <!-- 추천 탭 필터 -->
        <Grid Grid.Row="1"
              Margin="24,8,24,8"
              ColumnSpacing="16"
              Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsCatalogTabSelected), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     MaxWidth="360"
                     HorizontalAlignment="Left"
                     PlaceholderText="추천 목록 필터 (이름 · 카테고리 · ID)"
                     Text="{x:Bind ViewModel.CatalogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Grid.Column="1"
                      Content="설치된 항목 숨기기"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.HideInstalled, Mode=TwoWay}" />
        </Grid>

        <!-- 검색 탭 -->
        <Grid Grid.Row="1"
              Margin="24,8,24,8"
              ColumnSpacing="8"
              Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsSearchTabSelected), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     MaxWidth="420"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="winget 검색어 (예: chrome, powertoys, discord)"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchBoxKeyDown" />

            <Button Grid.Column="1"
                    Content="검색"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}" />

            <CheckBox Grid.Column="2"
                      Content="설치된 항목 숨기기"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.HideInstalled, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="2">
            <InfoBar Margin="24,0,24,0"
                     VerticalAlignment="Top"
                     IsClosable="False"
                     Severity="Warning"
                     Title="winget 이 필요합니다"
                     Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                     IsOpen="{x:Bind views:XamlHelpers.Not(ViewModel.WingetAvailable), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="앱 설치 관리자 열기" Command="{x:Bind ViewModel.OpenWingetHelpCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar Margin="24,0,24,0"
                     VerticalAlignment="Top"
                     IsClosable="False"
                     Severity="Informational"
                     Title="표시할 항목이 없습니다"
                     Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                     IsOpen="{x:Bind views:XamlHelpers.Neither(ViewModel.IsBusy, ViewModel.HasPackages), Mode=OneWay}"
                     Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.WingetAvailable), Mode=OneWay}" />

            <!-- 목록이 비어 있을 때만 중앙 로딩. 설치 중에는 항목 오른쪽·하단 바 ProgressRing만 사용 -->
            <ProgressRing Width="32" Height="32"
                          Margin="0,48,0,0"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Center"
                          IsActive="{x:Bind ViewModel.ShowCenterBusy, Mode=OneWay}"
                          Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowCenterBusy), Mode=OneWay}" />

            <ScrollViewer Padding="24,0,24,16"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.HasPackages), Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:WingetPackageInfo">
                            <Border Style="{StaticResource TweakCardStyle}" Padding="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind views:XamlHelpers.Not(IsInstalled), Mode=OneWay}" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       VerticalAlignment="Center" />

                                            <Border Style="{StaticResource BadgeBorderStyle}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind Category}" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Visibility="{x:Bind views:XamlHelpers.Show(Recommended)}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="추천" />
                                            </Border>

                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Visibility="{x:Bind views:XamlHelpers.Show(IsInstalled), Mode=OneWay}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="설치됨" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource DescriptionTextStyle}"
                                                   Visibility="{x:Bind views:XamlHelpers.ShowIfText(Description)}" />

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Id}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Version}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind views:XamlHelpers.ShowIfText(Version)}" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind LastError, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind views:XamlHelpers.ShowIfText(LastError), Mode=OneWay}" />
                                    </StackPanel>

                                    <ProgressRing Grid.Column="2"
                                                  Width="18" Height="18"
                                                  VerticalAlignment="Center"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind views:XamlHelpers.Show(IsBusy), Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CommandBarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center" />

                    <Button Content="새로 고침"
                            Command="{x:Bind ViewModel.LoadCommand}"
                            Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsCatalogTabSelected), Mode=OneWay}" />
                    <Button Content="선택 해제" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                    <Button Content="추천 항목 선택"
                            Command="{x:Bind ViewModel.SelectRecommendedCommand}"
                            Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowCatalogActions), Mode=OneWay}" />
                    <Button Content="선택 항목 설치"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InstallSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
