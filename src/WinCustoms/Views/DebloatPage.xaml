<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:WinCustoms.Services"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,12" Spacing="2">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 VerticalAlignment="Top"
                 Margin="24,4,24,0"
                 IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Success"
                 Title="정리할 앱이 없습니다"
                 Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind views:XamlHelpers.Hide(ViewModel.IsEmpty), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:AppxPackageInfo">
                        <Border Style="{StaticResource TweakCardStyle}" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind IsInstalled, Mode=OneWay}" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Visibility="{x:Bind views:XamlHelpers.Show(RecommendedForRemoval)}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="제거 권장" />
                                        </Border>

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Visibility="{x:Bind views:XamlHelpers.Hide(IsInstalled), Mode=OneWay}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="설치되어 있지 않음" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource DescriptionTextStyle}" />

                                    <TextBlock Text="{x:Bind LastError, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind views:XamlHelpers.ShowIfText(LastError), Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind views:XamlHelpers.Show(IsBusy), Mode=OneWay}"
                                                  Width="18" Height="18" />

                                    <HyperlinkButton Content="스토어에서 보기" Click="OnOpenStoreClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center" />

                    <CheckBox Content="설치되지 않은 항목도 표시"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind views:XamlHelpers.Not(ViewModel.HideUninstalled), Mode=OneWay}"
                              Click="OnShowAllClick" />

                    <Button Content="선택 해제" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                    <Button Content="권장 항목 선택" Command="{x:Bind ViewModel.SelectRecommendedCommand}" />
                    <Button Content="선택 항목 제거"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RemoveSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
