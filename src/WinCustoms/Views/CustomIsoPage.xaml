<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.CustomIsoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:WinCustoms.Common"
    xmlns:services="using:WinCustoms.Services"
    xmlns:vm="using:WinCustoms.ViewModels"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <InfoBar IsOpen="{x:Bind views:XamlHelpers.Not(ViewModel.OscdimgAvailable), Mode=OneWay}"
                         IsClosable="False"
                         Severity="Error"
                         Title="oscdimg.exe 없음"
                         Message="배포본 Tools\oscdimg\oscdimg.exe 가 없습니다. 파일을 다시 받아 주세요." />

                <!-- ISO 경로 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1. ISO 경로" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                   Text="적법하게 보유한 순정 Windows 11 ISO를 지정하세요. 결과 파일은 클린 설치용입니다." />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="순정 ISO"
                                     Text="{x:Bind ViewModel.SourceIsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseSourceIsoCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="2"
                                    Content="Windows 11 다운로드"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.OpenWindows11DownloadCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="저장할 커스텀 ISO"
                                     Text="{x:Bind ViewModel.OutputIsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseOutputIsoCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Header="에디션 (인덱스)"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Editions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedEdition, Mode=TwoWay}"
                                      IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="common:WindowsImageInfo">
                                        <TextBlock Text="{x:Bind DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="다시 읽기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.LoadEditionsCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 트윅 (카테고리별 접기) -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="2. 레지스트리 트윅" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           Text="카테고리를 펼쳐 선택하세요. install.wim 오프라인 적용 + 설치 완료/첫 로그온 2차 적용. Action·커스텀 항목은 ISO 미지원입니다." />
                                <TextBlock Text="{x:Bind ViewModel.TweaksSummary, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Content="추천"
                                        Command="{x:Bind ViewModel.SelectRecommendedTweaksCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button Content="해제"
                                        Command="{x:Bind ViewModel.ClearTweaksSelectionCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.TweakGroups, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomIsoTweakGroup">
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Summary, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CustomIsoSelectableTweak">
                                                        <Grid ColumnSpacing="8" Padding="2,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      MinWidth="0"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      IsEnabled="{x:Bind SupportsIso}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind Title}"
                                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <Border Grid.Column="2"
                                                                    Style="{StaticResource BadgeBorderStyle}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{x:Bind views:XamlHelpers.Hide(SupportsIso)}">
                                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="ISO 미지원" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 디블로트 (접기) -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="3. 기본 앱 제거 (프로비저닝)" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           Text="install.wim 오프라인 제거 + 설치 완료(SetupComplete) 2차 정리 + 재설치 방지 레지스트리. 에디션에 없는 앱은 건너뜁니다." />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap"
                                           Text="※ 삭제된 앱, 특히 마이크로소프트 스토어 앱을 다시 설치하는 것은 어려울 수 있다는 점에 유의하십시오." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Content="추천 선택"
                                        Command="{x:Bind ViewModel.SelectRecommendedDebloatCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button Content="선택 해제"
                                        Command="{x:Bind ViewModel.ClearDebloatSelectionCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="{x:Bind ViewModel.IsDebloatExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock Text="{x:Bind ViewModel.DebloatSummary, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Expander.Header>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DebloatPackages, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:AppxPackageInfo">
                                            <Grid ColumnSpacing="8" Padding="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          MinWidth="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource BadgeBorderStyle}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind views:XamlHelpers.Show(RecommendedForRemoval)}">
                                                    <TextBlock Style="{StaticResource BadgeTextStyle}" Text="제거 권장" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- 추가 옵션 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="4. 추가 옵션" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBlock Text="무인 설치 (Setup)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="선택한 에디션 기준으로 autounattend.xml 이 ISO에 포함됩니다. 라이선스·에디션·제품 키·언어는 자동, 설치 중 Windows Update 는 끔. 디스크/파티션 선택만 직접 하면 됩니다." />

                        <CheckBox IsChecked="{x:Bind ViewModel.BypassSetupRequirements, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Windows 11 설치 요구사항 우회"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="TPM 2.0 · Secure Boot · CPU · RAM · 저장소 등 Setup 검사를 끕니다 (boot.wim LabConfig + install MoSetup). 지원되지 않는 PC에 클린 설치할 때 사용합니다." />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{x:Bind ViewModel.InjectHostDrivers, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="현재 PC 드라이버 주입"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="이 PC에 설치된 드라이버를 내보낸 뒤 install.wim·boot.wim에 넣습니다. 같은 기기 재설치·스토리지/칩셋 호환에 유리합니다. 빌드 시간이 더 길어질 수 있습니다." />
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="설치 직후 OOBE"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="파티션 선택 후 설치가 끝나면 OOBE(계정·개인정보·진단)도 자동으로 건너뛰고 바탕화면까지 진행합니다. 25H2 에서 계정 화면이 뜨면 설치 중 인터넷을 끄세요." />

                        <CheckBox IsChecked="{x:Bind ViewModel.SkipOnlineAccount, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="온라인 Microsoft 계정 건너뛰기"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="OOBE에서 Microsoft 계정 로그인을 요구하지 않고 로컬 계정 경로를 엽니다 (BypassNRO + HideOnlineAccountScreens)." />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowLocalAccountOptions), Mode=OneWay}">
                            <TextBox Header="Windows 로컬 계정 이름"
                                     PlaceholderText="비우면 계정은 만들지 않음 (예: admin)"
                                     Text="{x:Bind ViewModel.LocalAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind ViewModel.CanEditLocalAccountOptions, Mode=OneWay}"
                                     MaxLength="20" />
                            <CheckBox IsChecked="{x:Bind ViewModel.EnableAutoLogon, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanEditLocalAccountOptions, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="자동 로그인"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="켜면 입력한 비밀번호로 계정을 만들고 이후 부팅마다 자동 로그인합니다. 끄면 비밀번호 없이 계정만 만듭니다." />
                                </StackPanel>
                            </CheckBox>
                            <PasswordBox x:Name="AutoLogonPasswordBox"
                                         Header="로컬 계정 비밀번호"
                                         PasswordChanged="AutoLogonPasswordBox_PasswordChanged"
                                         Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowAutoLogonPassword), Mode=OneWay}"
                                         IsEnabled="{x:Bind ViewModel.CanEditLocalAccountOptions, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowAutoLogonPassword), Mode=OneWay}"
                                       Text="자동 로그인을 켜면 입력한 비밀번호가 설치 시 적용되고, 이후 부팅마다 자동으로 로그인됩니다. ISO의 autounattend.xml에 Base64로 저장됩니다." />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowManualPasswordHint), Mode=OneWay}"
                                       Text="자동 로그인을 끄면 비밀번호 없이 로컬 계정이 만들어집니다. 설치 후 로그인 화면에서 암호 입력 없이 들어갈 수 있습니다." />
                        </StackPanel>

                        <CheckBox IsChecked="{x:Bind ViewModel.SkipPrivacyExperience, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="개인정보·진단 설정 건너뛰기"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="위치·진단·맞춤형 환경 등 OOBE 개인정보 질문 화면을 건너뜁니다." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Button Content="ISO 만들기"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.BuildCommand}"
                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />

                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowProgressPanel), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                             Height="8" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="취소"
                                    Command="{x:Bind ViewModel.CancelCommand}"
                                    Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.CanCancel), Mode=OneWay}" />
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}"
                                  MaxHeight="220"
                                  SelectionMode="None"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.HasLogLines), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
