<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.BootUsbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:WinCustoms.Common"
    xmlns:services="using:WinCustoms.Services"
    xmlns:vm="using:WinCustoms.ViewModels"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- 장치 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1. 장치 (USB / 외장)" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="새로고침"
                                    Command="{x:Bind ViewModel.RefreshDisksCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>
                        <ComboBox Header="대상 디스크"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Disks, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDisk, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="common:BootUsbDiskInfo">
                                    <TextBlock Text="{x:Bind DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   Text="작성 시 선택한 디스크의 모든 데이터가 삭제됩니다. 내장 SSD/HDD는 목록에 나오지 않습니다." />
                    </StackPanel>
                </Border>

                <!-- ISO -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="2. 부팅 선택 (Windows ISO)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="ISO 이미지"
                                     Text="{x:Bind ViewModel.SourceIsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="1" Content="찾아보기" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseIsoCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="2" Content="Windows 11 다운로드" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.OpenWindows11DownloadCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>
                        <ComboBox Header="에디션 (선택 — 최적화 설정 사용 시에만 필요)"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="순정 그대로면 고르지 않아도 됩니다"
                                  ItemsSource="{x:Bind ViewModel.Editions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEdition, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="common:WindowsImageInfo">
                                    <TextBlock Text="{x:Bind DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="순정 그대로 구울 때는 에디션을 고르지 않아도 됩니다. 「최적화 설정」을 켠 뒤에만 적용할 에디션이 필요합니다." />
                    </StackPanel>
                </Border>

                <!-- Rufus 옵션 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="3. 파티션·포맷 옵션" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" Grid.Column="0" Header="파티션 구성"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.PartitionSchemeOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPartitionSchemeOption, Mode=TwoWay}"
                                      IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Header="대상 시스템"
                                     Text="{x:Bind ViewModel.TargetSystemText, Mode=OneWay}"
                                     IsReadOnly="True" />

                            <TextBox Grid.Row="1" Grid.Column="0" Header="볼륨 레이블"
                                     Text="{x:Bind ViewModel.VolumeLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}"
                                     MaxLength="11" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Header="파일 시스템"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.FileSystemOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedFileSystemOption, Mode=TwoWay}"
                                      IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />

                            <ComboBox Grid.Row="2" Grid.Column="0" Header="클러스터 크기"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.ClusterSizeOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedClusterSizeOption, Mode=TwoWay}"
                                      IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>

                        <CheckBox Content="빠른 포맷"
                                  IsChecked="{x:Bind ViewModel.QuickFormat, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        <CheckBox Content="확장 레이블과 아이콘 파일 만들기"
                                  IsChecked="{x:Bind ViewModel.CreateExtendedLabelAndIcon, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="확장 레이블은 탐색기 표시용입니다. 백신/Windows가 autorun.inf 를 막으면 아이콘만 생략하고 부팅 USB는 그대로 완료됩니다." />
                        <CheckBox Content="최적화 설정 (레지스트리 트윅 · 앱 제거 · 추가 옵션)"
                                  IsChecked="{x:Bind ViewModel.ShowOptimizationOptions, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="기본은 순정 ISO 그대로입니다. 최적화 설정을 켜면 아래에 트윅·앱 제거·OOBE 옵션이 나타납니다. GPT+NTFS 는 EFI(FAT32)+데이터(NTFS) 이중 파티션입니다." />
                    </StackPanel>
                </Border>

                <!-- 트윅 (커스텀 ISO와 동일) — 최적화 설정 ON 일 때만 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowOptimizationOptions), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="4. 레지스트리 트윅" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TweaksSummary, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="추천 선택"
                                    Command="{x:Bind ViewModel.SelectRecommendedTweaksCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TweakGroups, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomIsoTweakGroup">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CustomIsoSelectableTweak">
                                                        <Grid ColumnSpacing="8" Padding="2,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" MinWidth="0"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      IsEnabled="{x:Bind SupportsIso}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 디블로트 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowOptimizationOptions), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5. 기본 앱 제거" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="추천" Command="{x:Bind ViewModel.SelectRecommendedDebloatCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button Content="해제" Command="{x:Bind ViewModel.ClearDebloatSelectionCommand}"
                                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="{x:Bind ViewModel.IsDebloatExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock Text="{x:Bind ViewModel.DebloatSummary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Expander.Header>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DebloatPackages, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:AppxPackageInfo">
                                            <Grid ColumnSpacing="8" Padding="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- 추가 옵션 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowOptimizationOptions), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="6. 추가 옵션" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox IsChecked="{x:Bind ViewModel.BypassSetupRequirements, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <TextBlock Text="Windows 11 설치 요구사항 우회" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind ViewModel.InjectHostDrivers, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <TextBlock Text="현재 PC 드라이버 주입" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind ViewModel.SkipOnlineAccount, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <TextBlock Text="온라인 Microsoft 계정 건너뛰기" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </CheckBox>
                        <CheckBox IsChecked="{x:Bind ViewModel.SkipPrivacyExperience, Mode=TwoWay}"
                                  IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                            <TextBlock Text="개인정보·진단 설정 건너뛰기" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </CheckBox>
                        <TextBox Header="Windows 로컬 계정 이름"
                                 Text="{x:Bind ViewModel.LocalAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}"
                                 MaxLength="20" />
                    </StackPanel>
                </Border>

                <Button Content="부팅 USB 만들기"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.CreateCommand}"
                        IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />

                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowProgressPanel), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                             Height="8" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="취소"
                                    Command="{x:Bind ViewModel.CancelCommand}"
                                    Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.CanCancel), Mode=OneWay}" />
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}" MaxHeight="200" SelectionMode="None"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.HasLogLines), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
