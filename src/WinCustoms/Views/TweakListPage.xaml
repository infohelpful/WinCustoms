<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.TweakListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinCustoms.Models"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 페이지 헤더 ─────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="24,16,24,12" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource PageTitleTextStyle}"
                           Text="{x:Bind ViewModel.Title}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="전체 비활성화"
                            Command="{x:Bind ViewModel.DisableAllCommand}"
                            ToolTipService.ToolTip="이 페이지의 토글을 모두 끕니다. 반영하려면 하단에서 '선택 항목 적용'을 누르세요." />
                    <Button Content="전체 활성화"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.EnableAllCommand}"
                            ToolTipService.ToolTip="이 페이지의 토글을 모두 켭니다. 반영하려면 하단에서 '선택 항목 적용'을 누르세요." />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>

        <!-- ── 트윅 목록 ───────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tweaks, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TweakItem">
                        <Border Style="{StaticResource TweakCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 제목 · 배지 · 설명 -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <!-- 아직 적용되지 않은 변경 표시 -->
                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind views:XamlHelpers.Show(IsDirty), Mode=OneWay}">
                                            <TextBlock Text="변경됨"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Visibility="{x:Bind views:XamlHelpers.Show(RequiresAdmin)}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="관리자 권한" />
                                        </Border>

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Visibility="{x:Bind views:XamlHelpers.Show(RequiresExplorerRestart)}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="탐색기 재시작" />
                                        </Border>

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Visibility="{x:Bind views:XamlHelpers.Show(RequiresSignOut)}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="다시 로그인" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource DescriptionTextStyle}" />

                                    <!-- 마지막 오류 -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Margin="0,6,0,0"
                                                Visibility="{x:Bind views:XamlHelpers.Show(HasError), Mode=OneWay}">
                                        <FontIcon Glyph="&#xEA39;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{x:Bind LastError, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <HyperlinkButton Content="자세히 알아보기"
                                                     Padding="0,4,0,0"
                                                     Click="OnLearnMoreClick"
                                                     Visibility="{x:Bind views:XamlHelpers.ShowIfText(LearnMoreUrl)}" />
                                </StackPanel>

                                <!-- 조작 영역: 토글 또는 실행 버튼 -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind views:XamlHelpers.Show(IsBusy), Mode=OneWay}"
                                                  Width="20"
                                                  Height="20"
                                                  VerticalAlignment="Center" />

                                    <ToggleSwitch IsOn="{x:Bind IsRequested, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind views:XamlHelpers.Show(IsToggle)}" />

                                    <Button Content="{x:Bind ActionText}"
                                            Click="OnRunActionClick"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind views:XamlHelpers.Show(IsAction)}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── 하단 고정 커맨드 바 ─────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind views:XamlHelpers.AppliedSummary(ViewModel.AppliedCount, ViewModel.Tweaks.Count), Mode=OneWay}" />

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Visibility="{x:Bind views:XamlHelpers.ShowIfText(ViewModel.StatusMessage), Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center" />

                    <Button Content="새로 고침"
                            Command="{x:Bind ViewModel.RefreshCommand}" />

                    <Button Content="기본값 복원"
                            Command="{x:Bind ViewModel.RestoreDefaultsCommand}" />

                    <Button Content="선택 항목 적용"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplySelectedCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
