<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinCustoms.Views.SystemBackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinCustoms.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,8" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- 백업 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1. C: 백업 만들기" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                   Text="다시 시작 후 WinRE에서 C:를 오프라인으로 .wim 에 담습니다. USB/외장에 저장하세요. VSS·파일 제외·임시 복사가 필요 없습니다." />

                        <TextBox Header="이미지 이름"
                                 Text="{x:Bind ViewModel.ImageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="저장 경로 (.wim) — 외장 드라이브 권장"
                                     Text="{x:Bind ViewModel.ImageFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseSavePathCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>

                        <Button Content="C: 백업 시작"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.CaptureCommand}"
                                IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 복원 -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="2. C: 자동 복원" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                                   Text="복원할 WIM을 고른 뒤 「C: 자동 복원」을 누르면, 컴퓨터가 다시 시작된 다음 복원이 자동으로 시작됩니다." />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Header="복원할 WIM 파일"
                                     Text="{x:Bind ViewModel.RestoreImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="찾아보기"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseRestoreImageCommand}"
                                    IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                        </Grid>

                        <Button Content="C: 자동 복원"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.PrepareRestoreCommand}"
                                IsEnabled="{x:Bind views:XamlHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 진행 / 로그: 작업 중일 때만 표시 (비어 있으면 줄만 보여서 거슬림) -->
                <Border Style="{StaticResource TweakCardStyle}" Padding="16"
                        Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.ShowProgressPanel), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                             Height="8" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="취소"
                                    Command="{x:Bind ViewModel.CancelCommand}"
                                    Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.CanCancel), Mode=OneWay}" />
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}"
                                  MaxHeight="220"
                                  SelectionMode="None"
                                  Visibility="{x:Bind views:XamlHelpers.Show(ViewModel.HasLogLines), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CommandBarBorderStyle}">
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
